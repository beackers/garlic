        <button id="KeyX" x="140" y="304" width="50" height="38"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="165" y="323" text="x" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />
        <button id="KeyY" x="192" y="304" width="50" height="38"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="217" y="323" text="y" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />
        <button id="KeyPi" x="244" y="304" width="50" height="38"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="269" y="323" text="pi" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />

        <!-- Row 6: function strip -->
        <button id="KeySin" x="36" y="346" width="50" height="32"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="61" y="362" text="sin" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />
        <button id="KeyCos" x="88" y="346" width="50" height="32"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="113" y="362" text="cos" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />
        <button id="KeyTan" x="140" y="346" width="50" height="32"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="165" y="362" text="tan" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />
        <button id="KeySqrt" x="192" y="346" width="50" height="32"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="217" y="362" text="sqrt" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />
        <button id="KeyLn" x="244" y="346" width="50" height="32"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
