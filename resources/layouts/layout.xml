        <button id="KeyClear" x="36" y="128" width="50" height="38"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
