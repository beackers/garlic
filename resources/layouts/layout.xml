    <!--
        Garlic editor shell for a 390x390 round display.

        The expression area is identical on every keyboard page.  The page
        layouts below deliberately use the same button IDs/geometry so the
        delegate can swap layouts without changing editor logic.

        Page order:
          Numbers -> Letters -> Operators -> Functions -> Special -> Numbers
    -->

    <!-- ==================== NUMBERS ==================== -->
    <layout id="NumbersLayout">
