<?xml version="1.0" encoding="UTF-8"?>
<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <!--
        Garlic's main statement-entry screen.
        Target: vívoactive 5 (390x390, round AMOLED).

        The top portion is deliberately kept separate from the keyboard so the
        expression can eventually grow to multiple lines without changing the
        keyboard geometry.
    -->
    <layout id="MainLayout">

        <!-- Statement / expression area -->
        <label id="HistoryLabel"
            x="center"
            y="22"
            text="2x + 1 = 7"
            font="Graphics.FONT_SMALL"
            justification="Graphics.TEXT_JUSTIFY_CENTER"
            color="Graphics.COLOR_DK_GRAY" />

        <label id="ExpressionLabel"
            x="center"
            y="58"
            text="2x + 1"
            font="Graphics.FONT_LARGE"
            justification="Graphics.TEXT_JUSTIFY_CENTER"
            color="Graphics.COLOR_WHITE" />

        <!-- Cursor placeholder; the input code can eventually move this. -->
        <label id="CursorLabel"
            x="center"
            y="91"
            text="_"
            font="Graphics.FONT_SMALL"
            justification="Graphics.TEXT_JUSTIFY_CENTER"
            color="Graphics.COLOR_WHITE" />

        <!-- Small status/mode line -->
        <label id="ModeLabel"
            x="center"
            y="112"
            text="Expression"
            font="Graphics.FONT_XTINY"
            justification="Graphics.TEXT_JUSTIFY_CENTER"
            color="Graphics.COLOR_LT_GRAY" />

        <!-- Keyboard buttons.
             The labels are separate drawables so the same button hit regions
             can later be reused with dynamically rendered keycaps. -->

        <!-- Row 1: editing / structural keys -->
        <button id="KeyClear" x="36" y="136" width="50" height="38" background="Graphics.COLOR_DK_GRAY">
            <state id="stateDefault" color="Graphics.COLOR_DK_GRAY" />
            <state id="stateHighlighted" color="Graphics.COLOR_GRAY" />
            <state id="stateSelected" color="Graphics.COLOR_GRAY" />
            <state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" />
        </button>
        <label x="61" y="155" text="C" font="Graphics.FONT_SMALL" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />

        <button id="KeyBackspace" x="88" y="136" width="50" height="38" background="Graphics.COLOR_DK_GRAY">
            <state id="stateDefault" color="Graphics.COLOR_DK_GRAY" />
            <state id="stateHighlighted" color="Graphics.COLOR_GRAY" />
            <state id="stateSelected" color="Graphics.COLOR_GRAY" />
            <state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" />
        </button>
        <label x="113" y="155" text="DEL" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />

        <button id="KeyLeftParen" x="140" y="136" width="50" height="38" background="Graphics.COLOR_DK_GRAY">
            <state id="stateDefault" color="Graphics.COLOR_DK_GRAY" />
            <state id="stateHighlighted" color="Graphics.COLOR_GRAY" />
            <state id="stateSelected" color="Graphics.COLOR_GRAY" />
            <state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" />
        </button>
        <label x="165" y="155" text="(" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />

        <button id="KeyRightParen" x="192" y="136" width="50" height="38" background="Graphics.COLOR_DK_GRAY">
            <state id="stateDefault" color="Graphics.COLOR_DK_GRAY" />
            <state id="stateHighlighted" color="Graphics.COLOR_GRAY" />
            <state id="stateSelected" color="Graphics.COLOR_GRAY" />
            <state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" />
        </button>
        <label x="217" y="155" text=")" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />

        <button id="KeyEnter" x="244" y="136" width="50" height="38" background="Graphics.COLOR_DK_GRAY">
            <state id="stateDefault" color="Graphics.COLOR_DK_GRAY" />
            <state id="stateHighlighted" color="Graphics.COLOR_GRAY" />
            <state id="stateSelected" color="Graphics.COLOR_GRAY" />
            <state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" />
        </button>
        <label x="269" y="155" text="=" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />

        <!-- Row 2: numbers -->
        <button id="Key7" x="36" y="178" width="50" height="38"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="61" y="197" text="7" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />
        <button id="Key8" x="88" y="178" width="50" height="38"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="113" y="197" text="8" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />
        <button id="Key9" x="140" y="178" width="50" height="38"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="165" y="197" text="9" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />
        <button id="KeyDivide" x="192" y="178" width="50" height="38"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="217" y="197" text="/" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />
        <button id="KeyPower" x="244" y="178" width="50" height="38"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="269" y="197" text="^" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />

        <!-- Row 3 -->
        <button id="Key4" x="36" y="220" width="50" height="38"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="61" y="239" text="4" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />
        <button id="Key5" x="88" y="220" width="50" height="38"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="113" y="239" text="5" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />
        <button id="Key6" x="140" y="220" width="50" height="38"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="165" y="239" text="6" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />
        <button id="KeyMultiply" x="192" y="220" width="50" height="38"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="217" y="239" text="*" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />
        <button id="KeyMinus" x="244" y="220" width="50" height="38"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="269" y="239" text="-" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />

        <!-- Row 4 -->
        <button id="Key1" x="36" y="262" width="50" height="38"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="61" y="281" text="1" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />
        <button id="Key2" x="88" y="262" width="50" height="38"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="113" y="281" text="2" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />
        <button id="Key3" x="140" y="262" width="50" height="38"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="165" y="281" text="3" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />
        <button id="KeyPlus" x="192" y="262" width="50" height="38"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="217" y="281" text="+" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />
        <button id="KeyComma" x="244" y="262" width="50" height="38"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
        <label x="269" y="281" text="," font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />

        <!-- Row 5: common variables/constants -->
        <button id="Key0" x="36" y="304" width="50" height="38"><state id="stateDefault" color="Graphics.COLOR_DK_GRAY" /><state id="stateHighlighted" color="Graphics.COLOR_GRAY" /><state id="stateSelected" color="Graphics.COLOR_GRAY" /><state id="stateDisabled" color="Graphics.COLOR_DK_GRAY" /></button>
